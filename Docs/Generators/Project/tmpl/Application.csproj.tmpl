<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>{{package}}.Application</RootNamespace>
        <AssemblyName>$(RootNamespace)</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Application.Contracts\{{package}}.Application.Contracts.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Volo.Abp.Account.Application" Version="9.0.6" />
      <PackageReference Include="Volo.Abp.Identity.Application" Version="9.0.6" />
      <PackageReference Include="Volo.Abp.PermissionManagement.Application" Version="9.0.6" />
      <PackageReference Include="Volo.Abp.TenantManagement.Application" Version="9.0.6" />
      <PackageReference Include="Volo.Abp.FeatureManagement.Application" Version="9.0.6" />
      <PackageReference Include="Volo.Abp.SettingManagement.Application" Version="9.0.6" />
    </ItemGroup>

</Project>
