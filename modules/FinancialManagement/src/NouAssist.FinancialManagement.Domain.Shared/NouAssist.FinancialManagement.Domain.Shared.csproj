<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>NouAssist.FinancialManagement</RootNamespace>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Ddd.Domain.Shared" Version="10.0.1" />
    <PackageReference Include="Volo.Abp.Validation" Version="10.0.1" />
    <PackageReference Update="ConfigureAwait.Fody" Version="3.3.2" />
    <PackageReference Update="Fody" Version="6.9.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\FinancialManagement\*.json" />
    <Content Remove="Localization\FinancialManagement\*.json" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Volo.Abp.Ddd.Domain">
      <HintPath>..\..\..\..\..\..\..\.nuget\packages\volo.abp.ddd.domain\10.0.0\lib\net10.0\Volo.Abp.Ddd.Domain.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
